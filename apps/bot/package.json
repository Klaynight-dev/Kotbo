{
  "name": "@kotbo/bot",
  "version": "9.2",
  "private": true,
  "scripts": {
    "migrate:deploy": "cd ../.. && bun run db:migrate:deploy",
    "build:i18n": "bunx @inlang/paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "prestart": "bun run build:i18n && bun run migrate:deploy && bun run quality:gate",
    "build": "bun run build:i18n && bun run typecheck",
    "dev": "bun run build:i18n && bun run --watch src/launcher.ts",
    "dev:safe": "bun run build:i18n && bun run quality:gate && bun run --watch src/launcher.ts",
    "start": "bun run src/launcher.ts",
    "start:safe": "bun run quality:gate && bun run src/launcher.ts",
    "deploy-commands": "bun run build:i18n && bun run src/deploy-commands.ts",
    "test:unit": "bun run build:i18n && bun test --isolate --timeout 30000 src/tests",
    "test:coverage": "bun run build:i18n && bun test --isolate --timeout 30000 --coverage src/tests",
    "coverage:gate": "bun run scripts/coverage-gate.ts",
    "test:watch": "bun test --isolate --timeout 30000 --watch src/tests",
    "typecheck": "bun x tsgo -p tsconfig.json --noEmit",
    "typecheck:tsc": "bun x tsc -p tsconfig.json --noEmit",
    "quality:gate": "bun run build:i18n && bun run typecheck && bun run lint && bun run test:unit && bun run coverage:gate",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@arcscord/components": "^1.0.1",
    "@discordjs/voice": "0.19.2",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^0.19.6",
    "@kotbo/contracts": "workspace:*",
    "@kotbo/core": "workspace:*",
    "@kotbo/database": "workspace:*",
    "@kotbo/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@napi-rs/canvas": "^0.1.100",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/client-runtime-utils": "^7.10.0",
    "@sentry/bun": "^10.53.1",
    "@types/jsonwebtoken": "^9.0.10",
    "bullmq": "^5.76.11",
    "discord.js": "^14.26.4",
    "dotenv": "^16.6.1",
    "fflate": "^0.8.3",
    "franc-min": "^6.2.0",
    "hono": "^4.12.30",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "libsodium-wrappers": "0.8.4",
    "lru-cache": "11.0.2",
    "node-cron": "^3.0.3",
    "p-limit": "5.0.0",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "rss-parser": "^3.13.0",
    "socket.io": "^4.8.3",
    "stripe": "^22.6.0",
    "zod": "^3.25.51",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.22.0",
    "@types/node": "^22.19.19",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "eslint": "^8.57.0",
    "typescript": "^5.9.3"
  }
}
