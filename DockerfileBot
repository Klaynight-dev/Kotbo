# Stage 1: Build stage
FROM oven/bun:1-alpine AS builder

WORKDIR /app
ENV PRISMA_HIDE_UPDATE_MESSAGE=true

# Copy the bot-only workspace manifest and monorepo configuration
COPY package.bot.json ./package.json
COPY bun.bot.lock ./bun.lock
COPY tsconfig.json bunfig.toml ./

# Copy dependency definitions for caching
COPY packages/database/package.json packages/database/
COPY packages/core/package.json packages/core/
COPY packages/contracts/package.json packages/contracts/
COPY packages/shared/package.json packages/shared/
COPY apps/bot/package.json apps/bot/

# Install only the bot workspace and shared packages. Frontend-only dependencies
# such as xlsx are intentionally absent from this image.
RUN bun install --frozen-lockfile

# Copy source code
COPY packages/database packages/database
COPY packages/core packages/core
COPY packages/contracts packages/contracts
COPY packages/shared packages/shared
COPY apps/bot apps/bot

# Generate Prisma client
RUN bun run db:generate

# Stage 2: Runtime stage
FROM oven/bun:1-alpine

# Canvas text rendering requires system fonts (Alpine ships with none)
# postgresql-client provides pg_dump, used by the daily database backup job
RUN apk add --no-cache fontconfig ttf-dejavu postgresql-client \
  && fc-cache -f

WORKDIR /app

# Copy only necessary files for runtime
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/packages/database ./packages/database
COPY --from=builder /app/packages/core ./packages/core
COPY --from=builder /app/packages/contracts ./packages/contracts
COPY --from=builder /app/packages/shared ./packages/shared
COPY --from=builder /app/apps/bot ./apps/bot

ENV NODE_ENV=production
ENV DOCKER=true
ENV PRISMA_HIDE_UPDATE_MESSAGE=true

# Apply database migrations, deploy commands and start the bot
CMD ["sh", "-c", "bun run db:migrate:repair-production && bun run db:migrate:deploy && bun run --filter @kotbo/bot deploy-commands && bun run --filter @kotbo/bot start"]
