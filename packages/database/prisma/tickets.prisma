// ============================================================================
// TICKET SYSTEM
// ============================================================================

enum TicketStatus {
  // Demande deposee mais pas encore validee par le staff : aucun salon n'existe
  // encore. Seuls les tickets valides passent a OPEN.
  PENDING
  OPEN
  CLAIMED
  CLOSED
  // Ticket clos puis range : le salon survit en lecture seule dans la categorie
  // d'archives. Rien n'est supprime, et le staff peut desarchiver.
  ARCHIVED
  // Demande refusee a la validation : aucun salon n'a jamais ete cree.
  REJECTED
}

model Ticket {
  id            String       @id @default(cuid())
  guildId       String
  channelId     String?      @unique
  mode          String       @default("CHANNEL") // "CHANNEL", "DM", "THREAD"
  threadId      String?      @unique
  ticketTypeId  String?
  ticketTypeLabel String?
  staffRoleId   String?
  categoryId    String?
  userId        String       // Discord User ID of the opener
  username      String       // Username of the opener
  reason        String       // Reason requested in modal
  description   String       // Description requested in modal
  status        TicketStatus @default(OPEN)
  claimedById   String?      // Discord User ID of claiming staff
  claimedByName String?      // Username of claiming staff
  closedById    String?      // Discord User ID of closing staff
  closedByName  String?      // Username of closing staff
  transcriptId  String?      // Linked Transcript ID
  restoreCount  Int          @default(0)
  lastRestoredAt DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  closedAt      DateTime?
  inactivityAlertSent Boolean  @default(false)
  isAnonymous         Boolean  @default(false)
  staffServerGuildId  String?  // Si relay sur serveur staff, l'ID du serveur staff

  // ── Validation prealable (pre-accepte) ────────────────────────────────────
  // Le salon reste verrouille tant qu'aucun staff n'a pris le ticket en charge.
  // Memorise sur le ticket et pas seulement sur la config : la config peut
  // changer entre l'ouverture et la prise en charge.
  lockUntilClaim   Boolean   @default(false)
  reviewChannelId  String?   // Salon ou la demande attend sa validation
  reviewMessageId  String?   // Carte de validation a mettre a jour apres decision
  reviewedById     String?
  reviewedByName   String?
  reviewedAt       DateTime?
  rejectionReason  String?

  // ── Archivage ─────────────────────────────────────────────────────────────
  // Le salon reste en place, verrouille en lecture seule. `archivedFromCategoryId`
  // memorise d'ou il vient pour que le desarchivage le remette a sa place.
  archivedById            String?
  archivedByName          String?
  archivedAt              DateTime?
  archivedFromCategoryId  String?

  // ── Verrou anti-suppression ───────────────────────────────────────────────
  // Tant qu'il tient, aucune suppression n'est acceptee, ni depuis Discord ni
  // depuis le dashboard. `deletionLockedUntil` vide = verrou sans echeance.
  deletionLocked       Boolean   @default(false)
  deletionLockedUntil  DateTime?
  deletionLockedById   String?
  deletionLockedByName String?
  deletionLockReason   String?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, createdAt])
  @@index([guildId, status, createdAt])
  @@index([guildId, userId, status])
  @@index([guildId, status, inactivityAlertSent])
  @@index([guildId, transcriptId])
  // Comptage des tickets clos sur une journée (snapshot Pulse). Les autres accès
  // du Pulse sont déjà couverts : (guildId, status) est un préfixe de
  // (guildId, status, createdAt), et (guildId, createdAt) existe ci-dessus.
  @@index([guildId, closedAt])
  @@map("tickets")
}

/// Membres a qui l'ouverture de ticket est refusee. `expiresAt` vide = definitif.
model TicketBlacklist {
  id      String  @id @default(cuid())
  guildId String
  userId  String
  username String?
  reason  String?

  addedByUserId String?
  addedByTag    String?

  /// Un membre blackliste peut malgre tout demander la reouverture d'un de ses
  /// anciens tickets quand ce drapeau est vrai : la blacklist ferme alors la
  /// creation, pas le suivi d'un dossier deja ouvert.
  allowReopen Boolean @default(false)

  expiresAt DateTime?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([guildId, userId])
  @@index([guildId, createdAt])
  @@map("ticket_blacklist")
}

model Transcript {
  id             String    @id @default(cuid())
  guildId        String
  channelId      String
  channelName    String
  html           String
  startMessageId String?
  endMessageId   String?
  startTime      DateTime?
  endTime        DateTime?
  createdAt      DateTime  @default(now())

  @@index([guildId, createdAt])
  @@map("transcripts")
}

/// Reponse pre-ecrite que le staff insere dans un ticket en un clic.
///
/// Une macro peut aussi agir : fermer le ticket, requalifier son type, poser un
/// role, declencher l'enquete de satisfaction. Les compteurs d'usage servent au
/// classement dans le selecteur - une macro qu'on n'utilise jamais descend.
model TicketMacro {
  id       String  @id @default(cuid())
  guildId  String
  name     String
  /// Regroupement libre affiche dans le selecteur Discord.
  category String?
  emoji    String?
  /// Texte insere. Accepte {user}, {staff}, {ticket_id}, {ticket_type}, {server}.
  content  String
  enabled  Boolean @default(true)
  /// Ordre d'affichage a usage egal. Plus petit = plus haut.
  position Int     @default(0)

  /// Types de ticket auxquels la macro s'applique. Vide = tous.
  ticketTypeIds String[] @default([])
  /// Roles staff autorises a l'utiliser. Vide = tout le staff du ticket.
  allowedRoleIds String[] @default([])

  /// Mots-cles qui font proposer la macro au staff a l'ouverture du ticket.
  keywords String[] @default([])
  /// Postee automatiquement a l'ouverture, sans intervention du staff.
  autoSendOnOpen Boolean @default(false)

  // ── Actions attachees ──────────────────────────────────────────────────────
  // Appliquees apres l'envoi du message, dans cet ordre.
  setTicketTypeId     String?
  addRoleId           String?
  removeRoleId        String?
  requestSatisfaction Boolean @default(false)
  /// Ferme le ticket. Applique en dernier : les autres actions ont besoin
  /// que le ticket soit encore ouvert.
  closeTicket         Boolean @default(false)

  usageCount Int       @default(0)
  lastUsedAt DateTime?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, enabled])
  @@index([guildId, position])
  @@map("ticket_macros")
}
