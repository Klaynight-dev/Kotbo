model ScheduledTask {
  id              String   @id @default(cuid())
  guildId         String
  name            String
  type            String   // "CHANNEL_RESET", "SERVER_BACKUP", "DATA_EXPORT", "SEND_MESSAGE"
  cron            String   // Expression Cron (ex: "0 0 * * *")
  enabled         Boolean  @default(true)
  targetId        String?  // ID Discord cible (ex. ID du salon)
  lastRun         DateTime?

  // ── Type SEND_MESSAGE ──────────────────────────────────────────────────────
  /// Texte poste dans le salon cible.
  message         String?
  /// Embed facultatif : { title, description, color, imageUrl }. Un message
  /// peut n'avoir que l'un ou l'autre, mais pas ni l'un ni l'autre.
  messageEmbed    Json?
  /// Autorise @everyone, @here et les mentions de role. Refuse par defaut : une
  /// tache qui se repete ne doit pas pouvoir pinger tout le serveur par
  /// inadvertance, et le reglage se coche en connaissance de cause.
  allowMentions   Boolean  @default(false)
  /// Tache a usage unique : desactivee juste apres son execution. Permet de
  /// programmer un message a une date precise via un cron qui, sans cela, se
  /// redeclencherait chaque annee.
  runOnce         Boolean  @default(false)

  guild           Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([guildId])
  @@map("scheduled_tasks")
}


model AutoResponse {
  id             String   @id @default(cuid())
  guildId        String
  triggerType    String   @default("MESSAGE") // MESSAGE, FORM, TICKET
  trigger        String
  response       String?   // Text or JSON embed
  matchType      String   @default("CONTAINS") // EXACT, CONTAINS, REGEX
  enabled        Boolean  @default(true)
  roleIdToAdd    String?
  roleIdToRemove String?
  deleteTrigger  Boolean  @default(false)
  closeTicket    Boolean  @default(false)
  rejectForm     Boolean  @default(false)

  // Filtres de déclenchement
  allowedRoleIds    String[] @default([]) // Rôles autorisés (vide = tous)
  bannedRoleIds     String[] @default([]) // Rôles interdits
  allowedChannelIds String[] @default([]) // Salons autorisés (vide = tous)
  bannedChannelIds  String[] @default([]) // Salons interdits

  // Formulaire (si triggerType == FORM)
  formId            String?
  formQuestionLabel String?

  // Ticket (si triggerType == TICKET)
  ticketTypeId        String?
  ticketQuestionLabel String? // "reason", "description" ou label du champ

  // Réactions et Actions complexes
  reactions      String[] @default([])
  actions        Json?

  // Destination du message de réponse : DM (défaut), CHANNEL (salon du déclencheur), SPECIFIC_CHANNEL (salon choisi)
  responseDestination String  @default("DM")
  responseChannelId    String? // salon cible si responseDestination == SPECIFIC_CHANNEL
  relayToStaffServer   Boolean @default(false) // relaie aussi la réponse sur le serveur staff lié (si disponible)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([guildId])
  @@map("auto_responses")
}