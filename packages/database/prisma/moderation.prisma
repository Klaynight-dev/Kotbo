enum SanctionType {
  WARN
  KICK
  TIMEOUT
  TEMP_BAN
  BAN
  SOFTBAN
}

enum SanctionStatus {
  ACTIVE
  RESOLVED
  FAILED
}

enum CodePoliceRuleCategory {
  SIGNAL
  DANGER
  LANGUAGE_FEEDBACK
}

enum CodePoliceMatchType {
  EXACT
  REGEX
}

enum CodePoliceSeverity {
  INFO
  WARNING
  DANGER
}


enum LinkedAccountType {
  MANUAL
  AUTOMATIC
}

enum LinkedAccountStatus {
  PENDING
  VALIDATED
  REJECTED
}

model CodePoliceRule {
  id String @id @default(cuid())

  key String @unique
  guildId String?

  category CodePoliceRuleCategory
  matchType CodePoliceMatchType @default(EXACT)
  language String?
  pattern String
  label String
  feedback String
  severity CodePoliceSeverity @default(WARNING)
  enabled Boolean @default(true)

  guild Guild? @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("code_police_rules")
  @@index([guildId, category])
  @@index([category, enabled])
  @@index([language])
}


model LinkedAccount {
  id String @id @default(cuid())
  guildId String

  user1Id String
  user2Id String

  type LinkedAccountType @default(MANUAL)
  status LinkedAccountStatus @default(VALIDATED)

  reason String?
  metadata Json? // Pour stocker les preuves de détection

  linkedByUserId String? // Si manuel, qui l'a fait

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, user1Id, user2Id])
  @@index([guildId, user1Id])
  @@index([guildId, user2Id])
  @@map("linked_accounts")
}




model Sanction {
  id String @id @default(cuid())

  guildId String
  type SanctionType
  status SanctionStatus @default(ACTIVE)

  targetUserId String
  targetTag String?
  moderatorUserId String
  moderatorTag String?

  reason String
  durationSeconds Int?
  expiresAt DateTime?
  nextActionAt DateTime?

  // Poids du warn (1 = léger, 2 = normal, 3 = grave). Utilisé par le score
  // pondéré quand warnWeightingEnabled est actif sur la guilde.
  weight Int @default(1)

  resolvedAt DateTime?
  resolutionNote String?
  lastReportReminderAt DateTime?
  managerReportEscalatedAt DateTime?

  // ──────────────────────────────────────────────────────────────────────────
  // Contestation et archivage (module Appels)
  // ──────────────────────────────────────────────────────────────────────────

  // false = verrouillée : le membre ne peut plus la contester, définitivement.
  appealable         Boolean   @default(true)
  appealLockedAt     DateTime?
  appealLockedByUserId String?
  appealLockReason   String?

  // Archivée = désactivée mais conservée. Elle disparaît du casier actif et
  // (selon `Guild.countArchivedInWarnScore`) cesse de peser dans le score de
  // warns et l'escalade, sans jamais être effacée.
  archivedAt         DateTime?
  archivedByUserId   String?
  archiveReason      String?

  sanctionTableId String?
  sanctionTable   SanctionTable? @relation(fields: [sanctionTableId], references: [id], onDelete: SetNull)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  reports SanctionReport[]
  evidenceFiles SanctionEvidenceFile[]
  appealEntries BanAppealSanction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, createdAt])
  @@index([guildId, status, type])
  // Casier actif (non archivé) et liste des sanctions contestables
  @@index([guildId, archivedAt])
  @@index([guildId, targetUserId, archivedAt])
  @@index([status, nextActionAt])
  @@index([sanctionTableId])
  // Recherches par membre à travers plusieurs serveurs (casier + casier cross-serveur)
  @@index([targetUserId, createdAt])
  @@map("sanctions")
}

// Comptes bannis détectés comme supprimés par Discord (cron d'hygiène des bans).
// Permet de notifier le staff une seule fois et de proposer le nettoyage.
model BanHygieneRecord {
  id      String @id @default(cuid())
  guildId String
  userId  String
  userTag String? // Dernier tag connu avant suppression

  detectedDeletedAt DateTime  @default(now())
  notifiedAt        DateTime?
  unbannedAt        DateTime?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
  @@index([guildId, unbannedAt])
  @@map("ban_hygiene_records")
}

model SanctionTable {
  id        String   @id @default(cuid())
  guildId   String
  name      String   // Unique per guild, e.g. "Spam", "Insultes"
  
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  tiers     SanctionTier[]
  sanctions Sanction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, name])
  @@map("sanction_tables")
}

model SanctionTier {
  id              String       @id @default(cuid())
  tableId         String
  level           Int          // 1, 2, 3...
  action          SanctionType
  durationSeconds Int?
  customReason    String?
  
  table           SanctionTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tableId, level])
  @@map("sanction_tiers")
}

// Fichiers de preuve uploadés directement (captures d'écran, PDF, courtes vidéos)
// pour les rapports de sanction. Les octets sont stockés en base (comme les
// transcriptions HTML de `Transcript`) car le volume est strictement plafonné
// côté application (taille/fichier, nombre/sanction, quota cumulé/serveur).
model SanctionEvidenceFile {
  id String @id @default(cuid())

  guildId String
  sanctionId String?

  fileName String
  mimeType String
  size Int
  data Bytes

  uploadedByUserId String

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  sanction Sanction? @relation(fields: [sanctionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([guildId, sanctionId])
  @@index([guildId, createdAt])
  @@map("sanction_evidence_files")
}

model SanctionReport {
  id String @id @default(cuid())

  guildId String
  sanctionId String?

  staffPseudo String
  incidentAt DateTime
  memberPseudo String
  memberReference String

  sanctionType SanctionType
  sanctionDurationLabel String?
  brokenRules String
  detailedReason String
  evidenceLinks String[] @default([])
  additionalNotes String?

  createdByUserId String
  createdByTag String?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  sanction Sanction? @relation(fields: [sanctionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, createdAt])
  @@index([guildId, sanctionType])
  @@index([sanctionId])
  @@map("sanction_reports")
}
