enum NotificationTargetType {
  DISCORD_CHANNEL
  DISCORD_ROLE
  DM_STAFF_ROLE
  EMAIL
}

model DashboardSettings {
  guildId String @id

  email String @default("")
  emailEnabled Boolean @default(false)
  cloudBackup Boolean @default(true)
  debugLog Boolean @default(false)
  killSwitchEnabled Boolean @default(false)
  severityByModule Json?
  commandRestrictions Json?
  sidebarFavorites String[] @default([])
  messageTemplate String @default("🔔 {titre}\n\n{resume}\n\nSource: {source}\nAuteur: {auteur}\n\nPublié automatiquement par Kotbo.")

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("dashboard_settings")
}

model DashboardAuditLog {
  id String @id @default(cuid())

  guildId String
  channelId String?
  user String
  action String
  context String
  module String
  eventType String
  details String
  dateIso DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([guildId, dateIso])
  // L'etat du dashboard lit les journaux en deux passes ("Discord" d'un cote,
  // le reste de l'autre), toujours triees par date. Sans `eventType` dans
  // l'index, Postgres remonte l'historique complet du serveur et filtre ligne a
  // ligne : le cout grandit avec l'age du serveur, pas avec la page affichee.
  @@index([guildId, eventType, dateIso])
  @@map("dashboard_audit_logs")
}

model Notification {
  id String @id @default(cuid())
  guildId String
  userId String // Utilisateur cible (Discord ID)

  title String
  message String
  type String @default("INFO") // INFO, SUCCESS, WARNING, ERROR
  link String? // Lien vers la page concernée (ex: /absences)
  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, userId, isRead])
  @@map("notifications")
}

// ============================================================================
// GESTION CENTRALISÉE DU DASHBOARD
// ============================================================================

model DashboardFeatureConfig {
  id String @id @default(cuid())

  guildId String
  featureKey String // ex: "daily_algo", "youtube", "digest", "sanctions", etc.
  featureName String // Nom lisible

  enabled Boolean @default(true)

  // Configuration Discord
  channelId String? // Salon principal pour la feature
  secondaryChannelId String? // Salon secondaire si nécessaire
  requiredRoleId String? // Rôle requis pour accéder
  notificationRoleId String? // Rôle à mentionner pour les notifications

  // Configuration notifications
  notifyViaDiscordChannel Boolean @default(true) // Notifier sur Discord
  notifyViaDM Boolean @default(false) // Notifier en MP
  notifyOnlyStaffRoles Boolean @default(false) // Notifier seulement les rôles staff spécifiés

  // Logging et suivi
  loggingEnabled Boolean @default(true)
  userActivityTracking Boolean @default(true) // Suivre les activités des utilisateurs

  // Configuration supplémentaire (JSON pour flexibilité)
  metadata Json? // Pour stocker des config spécifiques à chaque feature

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  roleAccess DashboardRoleAccess[]
  roleAccessByRole DashboardFeatureRoleAccess[]
  notificationTargets NotificationTarget[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, featureKey])
  @@index([guildId, enabled])
  @@map("dashboard_feature_configs")
}

model DashboardFeatureRoleAccess {
  id String @id @default(cuid())

  guildId String
  featureConfigId String
  roleId String

  canView Boolean @default(false)
  canModerate Boolean @default(false)
  canConfigure Boolean @default(false)
  canDelete Boolean @default(false)
  metadata Json?

  featureConfig DashboardFeatureConfig @relation(fields: [featureConfigId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([featureConfigId, roleId])
  @@index([guildId, featureConfigId])
  @@map("dashboard_feature_role_accesses")
}

model DashboardRoleAccess {
  id String @id @default(cuid())

  guildId String
  featureConfigId String
  staffRoleLevel Int // Niveau du rôle staff (0 = Helper, 1 = Mod, 2 = Admin, etc.)

  canView Boolean @default(false)
  canModerate Boolean @default(false)
  canConfigure Boolean @default(false)
  canDelete Boolean @default(false)
  metadata Json?

  featureConfig DashboardFeatureConfig @relation(fields: [featureConfigId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([featureConfigId, staffRoleLevel])
  @@index([guildId, featureConfigId])
  @@map("dashboard_role_accesses")
}

model NotificationTarget {
  id String @id @default(cuid())

  guildId String
  featureConfigId String

  targetType NotificationTargetType // DISCORD_CHANNEL, DISCORD_ROLE, DM_STAFF_ROLE, EMAIL
  targetId String? // ID du rôle, channel, ou autre selon le type

  enabled Boolean @default(true)

  featureConfig DashboardFeatureConfig @relation(fields: [featureConfigId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, featureConfigId])
  @@map("notification_targets")
}

model DashboardUserSettings {
  guildId   String
  userId    String

  bentoLayout Json?       // Array of LayoutItem: [{ id, colSpan, rowSpan, visible }]
  themeId     String      @default("dark")
  customTheme Json?       // Custom theme colors/settings
  accentColor String      @default("violet")
  sidebarBehavior String  @default("auto")
  compactMode Boolean     @default(false)

  // Fuseau de lecture des statistiques. Nul = suivre le fuseau du navigateur :
  // les agregats sont stockes en UTC, et les rendre tels quels annoncait a un
  // lecteur parisien un pic de 14h comme un pic de midi.
  timezone    String?

  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([guildId, userId])
  @@map("dashboard_user_settings")
}

// Presets de disposition Bento - sauvegardés par utilisateur, partageables
model DashboardLayoutPreset {
  id          String   @id @default(cuid())

  guildId     String
  creatorId   String   // Discord userId du créateur

  name        String
  description String?  @default("")
  layout      Json     // Array<LayoutItem>
  isPublic    Boolean  @default(false)
  shareToken  String?  @unique // Token unique pour import par URL

  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([guildId, creatorId])
  @@map("dashboard_layout_presets")
}
