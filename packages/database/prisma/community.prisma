model FunGameState {
  guildId            String   @id
  countingCurrent    Int      @default(0)
  countingLastUserId String?
  oneWordStoryLastUserId String?
  guessNumberTarget  Int      @default(0)
  wordChainLastWord    String?
  wordChainLastUserId  String?
  /** Rébus courant, ex. "🦁👑" - résolu contre `emojiRiddleAnswer` (JSON des réponses acceptées). */
  emojiRiddleEmojis    String?
  emojiRiddleAnswer    String?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@map("fun_game_states")
}

model DeveloperExcuse {
  id        String   @id @default(cuid())
  text      String
  language  String   @default("fr")
  category  String?
  createdAt DateTime @default(now())

  @@map("developer_excuses")
  @@index([language])
  @@index([category])
}

model Giveaway {
  id             String   @id @default(cuid())
  guildId        String
  channelId      String
  messageId      String?
  prize          String
  description    String?
  winnerCount    Int      @default(1)
  endsAt         DateTime
  ended          Boolean  @default(false)
  /// Auteur du giveaway, affiché sur la page publique. `null` pour les
  /// giveaways créés avant l'ajout de la colonne.
  createdById    String?

  participants   String[] @default([]) // Array of User IDs
  winners        String[] @default([]) // Array of User IDs

  // RPG / Économie additionnels
  rpgXp          Int      @default(0)
  rpgCoins       Int      @default(0)
  rpgItemId      String?
  needValidation Boolean  @default(false)
  validationStatus String @default("APPROVED") // PENDING, APPROVED, REJECTED
  pendingWinners String[] @default([]) // Gagnants potentiels en attente de validation

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // La page publique liste les giveaways d'un serveur en séparant ceux en
  // cours de ceux terminés, triés par date de fin.
  @@index([guildId, ended, endsAt])
  @@map("giveaways")
}

/// Réglages des giveaways d'un serveur : qui peut les lancer, qui peut y jouer.
///
/// Sans cette table, seuls « Gérer les messages » côté Discord et les
/// administrateurs du dashboard pouvaient créer un concours : aucun moyen de
/// confier les giveaways à une équipe animation sans lui donner des droits de
/// modération.
model GiveawayConfig {
  guildId String @id

  /// Rôles autorisés à créer, clôturer, relancer et supprimer un giveaway,
  /// en plus des administrateurs et des porteurs de « Gérer les messages ».
  managerRoleIds String[] @default([])

  /// Rôles exigés pour participer. Vide = ouvert à tout le serveur.
  requiredRoleIds String[] @default([])

  /// Rôles exclus de la participation, prioritaires sur `requiredRoleIds`.
  blockedRoleIds String[] @default([])

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("giveaway_configs")
}


model Suggestion {
  id             String   @id @default(cuid())
  guildId        String
  userId         String
  username       String
  content        String
  status         String   @default("PENDING") // PENDING, APPROVED, REJECTED, IMPLEMENTED
  channelId      String?
  messageId      String?
  responseText   String?
  respondedById  String?
  respondedAt    DateTime?

  upvoters       String[] @default([]) // Array of User IDs
  downvoters     String[] @default([]) // Array of User IDs

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("suggestions")
}

model ReactionRoleMenu {
  id        String   @id @default(cuid())
  guildId   String
  channelId String
  messageId String?
  title     String
  options   Json     // List of { emoji: string, label: string, roleId: string }

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  @@map("reaction_role_menus")
}
