// ============================================================================
// TICKET SATISFACTION - FEEDBACK POST-RÉSOLUTION
// ============================================================================

model TicketSatisfaction {
  id String @id @default(cuid())

  guildId   String
  ticketId  String
  userId    String // Membre qui donne son avis
  staffId   String? // Staff qui a géré le ticket

  rating     Int // 1-5
  comment    String?
  respondedAt DateTime @default(now())

  // Question facultative en attente de réponse dans les DM du membre. Ces trois
  // champs sont posés à l'affichage du bouton et remis à null dès qu'il est
  // résolu (commentaire, refus ou expiration) : ils survivent à un redémarrage
  // du bot, que le minuteur en mémoire ne ferait pas.
  commentPromptChannelId String?
  commentPromptMessageId String?
  commentPromptExpiresAt DateTime?

  // Message publié dans le salon des avis. Conservé pour pouvoir l'éditer quand
  // le commentaire arrive après la note, et pour ne jamais publier deux fois.
  reviewLogChannelId String?
  reviewLogMessageId String?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([guildId, ticketId, userId])
  @@index([guildId, staffId])
  @@index([guildId, createdAt])
  @@index([commentPromptExpiresAt])
  @@map("ticket_satisfactions")
}
