// ============================================================================
// SYSTEME D'ADMINISTRATION GLOBALE
// ============================================================================

model GlobalAdmin {
  userId String @id
  addedBy String
  createdAt DateTime @default(now())

  @@map("global_admins")
}

model ActivationCode {
  id            String    @id @default(cuid())
  code          String    @unique
  createdAt     DateTime  @default(now())
  createdById   String
  usedAt        DateTime?
  usedByGuildId String?   @unique
  isActive      Boolean   @default(true)

  // ── Accès à durée limitée ───────────────────────────────────────────────────
  // Type d'accès accordé au serveur qui consomme le code.
  // PERMANENT (comportement historique) | TRIAL | SUBSCRIPTION
  accessType      String @default("PERMANENT")
  // Durée de l'accès, en minutes. null = accès sans expiration (PERMANENT).
  // La minute est l'unité de stockage unique : elle couvre aussi bien un essai
  // commercial de 15 jours qu'une période de 30 minutes pour tester le flux.
  durationMinutes Int?
  // Note libre côté admin (nom du client, contexte commercial…).
  label           String?

  @@map("activation_codes")
}

model GlobalBlacklist {
  userId String @id
  reason String?
  addedBy String
  createdAt DateTime @default(now())

  @@map("global_blacklist")
}

model BotErrorLog {
  id String @id @default(cuid())
  message String
  stack String?
  source String? // ex: "Command /algo", "Event messageCreate"
  createdAt DateTime @default(now())

  @@map("bot_error_logs")
}

model BotGlobalConfig {
  key String @id // ex: "MAINTENANCE_MODE"
  value String // JSON stringified value
  updatedAt DateTime @updatedAt

  @@map("bot_global_config")
}

model BroadcastLog {
  id String @id @default(cuid())

  sentBy       String
  title        String
  message      String
  color        String    @default("#5865F2")
  thumbnailUrl String?
  imageUrl     String?
  footerText   String?
  target       String    @default("ALL") // ALL, ACTIVATED, CUSTOM
  targetGuilds String[]  @default([])
  channelPref  String    @default("NEWS") // NEWS, PUBLIC, STAFF, FALLBACK

  successCount Int       @default(0)
  failCount    Int       @default(0)
  totalTargeted Int      @default(0)

  // DRAFT | SCHEDULED | SENDING | SENT | CANCELLED | FAILED
  status      String    @default("SENT")
  scheduledAt DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  cancelledBy String?

  createdAt DateTime @default(now())

  deliveries BroadcastDelivery[]

  @@index([status])
  @@index([scheduledAt])
  @@index([createdAt])
  @@map("broadcast_logs")
}

// ============================================================================
// CONSOLE ADMIN - MEDIAS, MODELES ET TRACABILITE DES BROADCASTS
// ============================================================================

// Image hebergee par Kotbo pour les broadcasts.
// Discord refuse les URL `data:` et fait expirer ses propres liens CDN signes
// (`?ex=&is=&hm=`) : une image uploadee doit donc etre servie par une URL
// publique stable, sinon l'embed affiche "Echec du chargement de l'image".
model BroadcastMedia {
  id         String @id @default(cuid())
  // Jeton secret present dans l'URL publique : le media reste non listable
  // sans authentification, mais Discord peut le telecharger librement.
  token      String @unique
  fileName   String
  mimeType   String
  size       Int
  data       Bytes
  uploadedBy String
  usageCount Int    @default(0)

  createdAt DateTime @default(now())

  @@index([uploadedBy])
  @@map("broadcast_media")
}

model BroadcastTemplate {
  id           String   @id @default(cuid())
  name         String
  title        String?
  message      String
  color        String   @default("#5865F2")
  thumbnailUrl String?
  imageUrl     String?
  footerText   String?
  target       String   @default("ALL")
  targetGuilds String[] @default([])
  channelPref  String   @default("AUTO")

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdBy])
  @@map("broadcast_templates")
}

// Resultat d'envoi serveur par serveur : sans ce detail, un broadcast partiel
// ne remonte qu'un compteur d'echecs sans jamais dire lesquels ni pourquoi.
model BroadcastDelivery {
  id          String  @id @default(cuid())
  broadcastId String
  guildId     String
  guildName   String
  channelId   String?
  channelName String?
  // SENT | FAILED | SKIPPED
  status      String
  reason      String?
  messageId   String?

  createdAt DateTime @default(now())

  broadcast BroadcastLog @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@index([broadcastId])
  @@index([guildId])
  @@index([status])
  @@map("broadcast_deliveries")
}

// Journal des actions sensibles de la console admin globale.
model AdminAuditLog {
  id         String  @id @default(cuid())
  actorId    String
  actorName  String?
  // ex: "broadcast.send", "guild.leave", "shard.restart"
  action     String
  targetType String?
  targetId   String?
  summary    String
  metadata   Json?
  ip         String?
  // OK | FAILED
  outcome    String  @default("OK")

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}
