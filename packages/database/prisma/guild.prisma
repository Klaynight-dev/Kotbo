enum DigestFrequency {
  DAILY
  WEEKLY
}


model Guild {
  id String @id
  propagateSanctions Boolean @default(false)
  // Vue "casier cross-serveur" : partage/consultation de l'historique des sanctions
  // entre serveurs d'une même instance white-label. Réciproque : un serveur désactivé
  // ne partage plus ses sanctions ET ne voit plus celles des autres.
  crossServerSanctionsEnabled Boolean @default(true)

  // White-label instance (null = instance principale/default)
  instanceId String?
  instance   WhiteLabelInstance? @relation("WhiteLabelGuilds", fields: [instanceId], references: [id], onDelete: SetNull)


  configChannelId String?
  regulationChannelId String?
  regulationMessageId String?
  // Le règlement peut dépasser les limites de taille d'un message Discord : il est
  // alors publié en plusieurs messages. `regulationMessageId` reste le premier
  // message (compatibilité dashboard), `regulationMessageIds` liste la suite dans
  // l'ordre de publication.
  regulationMessageIds String[] @default([])
  regulationVerificationEnabled Boolean @default(false)
  regulationRoleId             String?
  regulationLockEnabled        Boolean @default(false)
  publicChannelId String?
  digestChannelId String?
  meetingAnnouncementChannelId String?
  meetingVoiceChannelId String?
  staffAnnouncementChannelId String?

  // Salon d'annonce des événements personnalisés
  eventAnnouncementChannelId String?



  moderatorRoleId   String?
  baseStaffRoleId   String?
  testStaffRoleId   String?

  recruitmentCategoryId  String?
  recruitmentLogChannelId String?

  digestEnabled    Boolean         @default(false)
  digestFrequency  DigestFrequency @default(DAILY)
  digestTime       String          @default("08:00") // HH:MM
  digestCount      Int             @default(10)
  digestRoleId     String?
  digestCustomText String?

  translationEnabled Boolean @default(false)
  defaultTranslateTo String  @default("FR")

  // Langue des réponses du bot sur ce serveur (override de la locale Discord).
  // null = pas de préférence explicite, on retombe sur interaction.locale/guildLocale.
  language String?

  // Identifiant IANA du fuseau du serveur (`Europe/Paris`, `America/Montreal`…).
  // Le process tourne en UTC : sans ce champ, toute date saisie ou affichée par
  // le bot est décalée du fuseau réel du serveur.
  timezone String @default("Europe/Paris")

  globalIncludeKeywords String[] @default([])
  globalExcludeKeywords String[] @default([])
  globalIgnoredKeywords String[] @default([])
  preferencesMigrated Boolean @default(false)

  codePoliceEnabled        Boolean @default(false)
  codePoliceRules          CodePoliceRule[]

  autoNicknameModerationEnabled Boolean   @default(false)
  nicknameModerationWhitelist  String[]  @default([])
  nicknameModerationBypass     String[]  @default([])
  nickModOnJoin                Boolean   @default(true)
  nickModOnUpdate              Boolean   @default(true)
  nickModCheckInvisible        Boolean   @default(true)
  nickModCheckGlobal           Boolean   @default(true)
  nickModCheckCustom           Boolean   @default(true)
  nickModDiscordAutoModSync    Boolean   @default(false)
  bannedWords              BannedWord[]

  dailyAlgoEnabled         Boolean @default(false)
  dailyAlgoChannelId       String?
  dailyAlgoValidationChannelId String?
  dailyAlgoTime            String  @default("09:00") // HH:MM
  // Fuseau de référence du module : détermine la journée, la semaine ISO et
  // quels jours comptent comme week-end. `dailyAlgoTime` reste interprété en UTC
  // pour l'heure d'envoi, comme avant.
  dailyAlgoTimezone        String  @default("Europe/Paris")

  // ── Barème de points ───────────────────────────────────────────────────────
  // Points garantis pour toute soumission approuvée, même mal notée.
  dailyAlgoParticipationPoints Int   @default(1)
  dailyAlgoWeekendMultiplier   Float @default(1.5)

  // ── Semaine compétitive & podium ───────────────────────────────────────────
  dailyAlgoWeeklyRewardsEnabled Boolean @default(false)
  // Rôles du podium : facultatifs. Laisser vide = aucun rôle attribué, les
  // autres récompenses de la semaine fonctionnent quand même.
  dailyAlgoWeekRole1Id          String?
  dailyAlgoWeekRole2Id          String?
  dailyAlgoWeekRole3Id          String?
  // Retire les rôles du podium précédent à chaque clôture.
  dailyAlgoWeekRoleRotate       Boolean @default(true)
  dailyAlgoWeekXp1              Int @default(500)
  dailyAlgoWeekXp2              Int @default(300)
  dailyAlgoWeekXp3              Int @default(150)
  // XP versée à tout membre ayant au moins une soumission approuvée dans la semaine.
  dailyAlgoWeekParticipationXp  Int @default(100)
  dailyAlgoWeekAnnouncementChannelId String?

  // ── Sanction depuis la notation ────────────────────────────────────────────
  dailyAlgoSanctionType            String @default("WARN") // WARN | TIMEOUT
  dailyAlgoSanctionWeight          Int    @default(1)
  dailyAlgoSanctionDurationMinutes Int    @default(60)

  githubReleasesEnabled    Boolean @default(false)
  githubReleasesChannelId  String?
  githubRepositories       String[] @default(["facebook/react", "docker/compose", "microsoft/typescript", "vercel/next.js", "sveltejs/svelte"])

  statusCheckChannelId     String?
  logChannelId             String?
  // Salons dont l'activité ne doit générer aucun log avancé (messages, vocal).
  logIgnoredChannelIds     String[] @default([])

  youtubeEnabled           Boolean @default(false)
  youtubeChannelId         String?
  nathanChannelId          String?
  youtubeShortRoleId       String?
  youtubeVideoRoleId       String?

  // Configuration de la modération du personnel
  warnsToDemote               Int      @default(3)
  warnsToBlacklist            Int      @default(5)
  blacklistPermanentByDefault Boolean  @default(false)
  actionMode                  String   @default("MANUAL") // AUTO, MANUAL
  demoteRemoveAllRoles        Boolean  @default(false)

  sanctionSyncEnabled      Boolean @default(false)
  sanctionReportEnabled    Boolean @default(true)
  // Sanctionner un bot (webhook fou, bot compromis) n'a pas de victime a
  // documenter ni de membre a qui rendre des comptes : le rapport n'apporte
  // rien. Desactive par defaut pour ne rien changer aux serveurs en place.
  sanctionReportSkipBots   Boolean @default(false)
  sanctionAlertChannelId   String?
  newsChannelId            String?

  // Salon choisi pour recevoir les broadcasts globaux Kotbo
  broadcastChannelId       String?

  activated                Boolean   @default(false)
  activatedAt              DateTime?
  activationCode           String?
  // Fin du parcours de configuration, et rien d'autre : ni l'offre, ni un
  // acces accorde, ni le statut de la personne connectee ne le remplacent.
  // Tant que cette date est nulle, le dashboard sert le parcours - c'est la
  // seule sortie, et elle appartient au serveur, pas au navigateur ni au
  // visiteur. Ecrite par le paiement (`syncSubscription`) ou par le dernier
  // ecran quand il n'y a rien a payer.
  onboardingCompletedAt    DateTime?
  // Ou l'on en est du parcours, et ce qu'on y a repondu.
  //
  // Le parcours vivait dans le seul `localStorage` : changer d'appareil en
  // cours de route repartait du debut, et le tableau de bord n'avait aucun
  // moyen de proposer « finissez votre configuration ». Le navigateur reste la
  // source rapide - il ecrit a chaque clic, sans aller-retour reseau - et cette
  // colonne recoit la meme chose a chaque etape validee. Au chargement, c'est
  // la version la plus avancee des deux qui gagne.
  //
  // En JSON plutot qu'en colonnes : ce que le parcours retient change a chaque
  // ecran qu'on lui ajoute, et une migration par question rendrait le parcours
  // couteux a faire evoluer. Rien ici ne fait foi cote bot - le serveur Discord
  // reste seul juge de ce qui est reellement pose.
  onboardingState          Json?
  // true si l'activation provient d'une cascade StaffServerLink (serveur staff lié à un principal activé), pas d'un code direct
  activatedViaStaffLink    Boolean   @default(false)

  // ── Accès à durée limitée (essai, abonnement) ──────────────────────────────
  // Nature de l'accès courant : PERMANENT (jamais d'expiration) | TRIAL | SUBSCRIPTION.
  // Pensé pour être piloté par n'importe quelle couche (code d'activation, futur
  // module de paiement) via `accessService`, jamais écrit à la main ailleurs.
  accessType               String    @default("PERMANENT")
  // Date d'expiration de l'accès. null quand accessType = PERMANENT.
  accessExpiresAt          DateTime?
  // Date à laquelle l'accès a effectivement expiré (trace conservée après désactivation).
  accessExpiredAt          DateTime?
  // Durée totale de la période en cours, en minutes. Sert à calculer des paliers
  // de rappel proportionnels ; stockée ici pour rester juste même quand l'accès
  // ne vient pas d'un code (geste commercial, futur paiement).
  accessDurationMinutes    Int?
  // Paliers de rappel (en minutes restantes) déjà notifiés, pour ne jamais renvoyer deux fois le même.
  accessRemindersSent      Int[]     @default([])

  // ── Offre commerciale (facturation Stripe) ─────────────────────────────────
  // Offre courante : FREE | PLUS | PRO | ULTIMATE | CUSTOM. Décide des modules
  // ouverts (`planIncludesModule` dans @kotbo/contracts, appliqué par `moduleGate`).
  // Écrit uniquement par `planService`, jamais à la main depuis une route.
  plan                     String    @default("FREE")
  // Client Stripe rattaché au serveur. Créé au premier paiement et réutilisé
  // ensuite : c'est lui qui porte le moyen de paiement et l'historique de
  // factures affiché dans le portail client.
  stripeCustomerId         String?   @unique
  // Abonnement Stripe en cours. Un serveur n'en a qu'un à la fois : changer
  // d'offre modifie cet abonnement au lieu d'en ouvrir un second.
  stripeSubscriptionId     String?   @unique
  // Dernier statut connu, recopié de Stripe : active, trialing, past_due,
  // canceled… Sert à afficher un bandeau d'impayé sans interroger l'API.
  stripeSubscriptionStatus String?
  // Prix souscrit, seule donnée qui permet de retrouver l'offre et la
  // périodicité si les variables d'environnement changent de nom.
  stripePriceId            String?
  // Résiliation demandée : l'abonnement court jusqu'à la fin de la période
  // payée puis s'arrête. Le serveur garde son offre jusque-là.
  stripeCancelAtPeriodEnd  Boolean   @default(false)
  // Fin de la période payée en cours, telle que Stripe la déclare. C'est elle
  // qui alimente `accessExpiresAt`, donc les rappels et l'expiration.
  stripeCurrentPeriodEnd   DateTime?
  // Utilisateur Discord qui a engagé la dépense : celui qui a lancé le
  // paiement, ou qui a reçu le serveur en cadeau. C'est lui « le payeur » au
  // sens de la page Facturation, qui lui reste ouverte même s'il perd ses
  // droits d'administration Discord - on ne coupe pas quelqu'un de sa propre
  // facture.
  billingOwnerId           String?
  // Ouvre la page Facturation à tout le staff du serveur (niveau modérateur et
  // au-dessus) et non aux seuls administrateurs. Faux par défaut : un montant
  // débité et une adresse de facturation n'ont pas à circuler dans une équipe
  // de modération sans décision explicite.
  billingStaffAccess       Boolean   @default(false)
  // Echeance annuelle pour laquelle l'avis de reconduction a deja ete envoye.
  //
  // L'article L215-1 du code de la consommation impose de prevenir le
  // consommateur entre trois mois et un mois avant le terme d'un abonnement a
  // reconduction tacite. Stocker la date d'echeance visee - et non un simple
  // booleen - rend l'envoi idempotent d'une annee sur l'autre : a la
  // reconduction suivante, `stripeCurrentPeriodEnd` change, et l'avis repart.
  renewalNoticeSentFor     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clansEnabled      Boolean @default(false)
  /// Héritée : l'unicité de clan est désormais toujours appliquée. La colonne
  /// reste pour ne pas casser les bases existantes, mais plus rien ne la lit.
  clansUnique       Boolean @default(true)
  clanAutoAssignOnJoin Boolean @default(false)
  /// Bilan hebdomadaire publié dans le QG de chaque clan : points de la semaine,
  /// meilleurs contributeurs, place au classement. Éteint par défaut, le QG étant
  /// un salon de discussion où personne n'a demandé à recevoir un rapport.
  clanWeeklyDigest     Boolean @default(false)
  currentClanSeason Int     @default(1)
  clanSeasonStartsAt DateTime?
  clanSeasonEndsAt   DateTime?
  clanXpFromLevelUp  Boolean @default(false)
  clanXpPerLevelUp   Int     @default(50)
  /// Verse un montant proportionnel à l'XP réellement franchie au lieu du
  /// forfait `clanXpPerLevelUp`. Avec une courbe quadratique, le forfait fait
  /// rapporter à un vétéran plusieurs fois moins de points par message qu'à un
  /// débutant, alors que les deux fournissent le même effort.
  clanXpLevelUpProportional Boolean @default(false)
  /// Niveau auquel `clanXpPerLevelUp` reste versé tel quel en mode
  /// proportionnel. En dessous le versement est plus faible, au-dessus plus
  /// élevé, à proportion de l'XP réellement franchie.
  clanXpReferenceLevel Int   @default(25)
  clanXpFromBoost    Boolean @default(false)
  clanXpPerBoost     Int     @default(100)
  lastWinningClanId  String?
  clanAnnouncementChannelId String?

  // ── Paris entre membres (onglet Paris de l'espace Clans) ──────────────────
  /// Interrupteur propre à l'onglet. Distinct de `clansEnabled` : les paris
  /// s'appuient sur les points de clan, mais un serveur peut vouloir des clans
  /// sans paris. Éteindre les clans éteint les paris, l'inverse n'est pas vrai.
  betsEnabled Boolean @default(false)

  /// Salon où les paris sont ouverts, et salon où le récapitulatif est publié
  /// une fois le verdict rendu. Sans valeur, le bot retombe sur les salons
  /// nommés « faire-des-paris » et « annonce-paris ».
  betChannelId             String?
  betAnnouncementChannelId String?

  betMinStake          Int @default(10)
  betMaxStake          Int @default(10000)
  /// Paris ouverts simultanément par membre, propositions comprises. Chaque
  /// pari accepté gèle des points : sans plafond, un membre immobilise tout son
  /// score et sature le salon de défis que personne n'a demandés.
  betMaxOpenPerMember  Int @default(5)
  /// Au-delà, une proposition jamais acceptée cesse d'être cliquable.
  betAcceptWindowHours Int @default(48)

  /// Formes de paris ouvertes aux membres, en plus du duel qui l'est toujours.
  betAllowPool  Boolean @default(false)
  betAllowTeams Boolean @default(false)
  /// Autorise les paris que n'importe qui peut rejoindre, sans adversaire
  /// désigné.
  betAllowOpen  Boolean @default(false)

  /// PER_MEMBER | PER_SIDE : mise fixée par personne, ou par camp et divisée
  /// entre ses places. `PER_SIDE` impose des camps à effectif fixe, la mise
  /// individuelle devant être connue avant que chacun ne paie en entrant.
  betStakeMode String @default("PER_MEMBER")

  /// Participants et camps par pari. Le premier borne la taille du pot, le
  /// second le nombre de boutons tenables dans une annonce.
  betMaxParticipants Int @default(10)
  betMaxSides        Int @default(4)

  /// Récompense le podium des parieurs à la clôture d'une saison.
  ///
  /// Le palmarès existe toute la saison mais ne débouchait sur rien : sans
  /// enjeu à l'arrivée, il n'est qu'un tableau de plus.
  betSeasonRewardEnabled Boolean @default(false)
  /// Rôle donné au meilleur parieur, retiré à ses porteurs précédents à chaque
  /// clôture - comme le rôle de chef de clan.
  betSeasonRewardRoleId  String?
  /// Prime en points de clan versée sur la **nouvelle** saison : créditée sur
  /// l'ancienne, elle serait invisible dans un classement déjà clos. À zéro par
  /// défaut, pour qu'activer la récompense ne fausse pas un départ de saison
  /// sans qu'on l'ait voulu.
  betRewardTop1 Int @default(0)
  betRewardTop2 Int @default(0)
  betRewardTop3 Int @default(0)

  /// Autorise à miser des points qu'on n'a pas encore. Le manque devient une
  /// dette (`ClanPointDebt`) prélevée sur les gains futurs.
  betAllowDebt Boolean @default(false)
  /// Plafond de dette par membre. Sans lui, un membre mise indéfiniment des
  /// points qu'il ne possède pas.
  betMaxDebt   Int     @default(5000)
  /// Efface les dettes à la clôture d'une saison. Désactivé par défaut : une
  /// dette effaçable en attendant la fin de saison revient à offrir la mise à
  /// qui parie au bon moment.
  betDebtResetOnSeason Boolean @default(false)

  /// Rôles autorisés à trancher un pari, en plus des administrateurs.
  betResolverRoleIds String[] @default([])
  clanRewardGiveaway Boolean @default(false)
  clanRewardXpBoost  Boolean @default(false)
  clanRewardXpBoostRate Float @default(1.2)
  clanRewardLeaderRole Boolean @default(false)

  // ── Pont Daily Algo → Clans ────────────────────────────────────────────────
  // Troisième interrupteur, indépendant de `clansEnabled` et `dailyAlgoEnabled` :
  // les deux modules fonctionnent seuls, ce réglage ne fait que les relier.
  // À la clôture hebdomadaire, chaque participant convertit ses points de la
  // semaine en points de clan (1 pour 1 par défaut).
  clanPointsFromDailyAlgo     Boolean @default(false)
  clanPointsFromDailyAlgoRate Float   @default(1.0)
  // Bonus forfaitaires versés au clan du podium, en plus de la conversion.
  clanPointsDailyAlgoTop1     Int @default(30)
  clanPointsDailyAlgoTop2     Int @default(20)
  clanPointsDailyAlgoTop3     Int @default(10)

  // ── Pont RPG → Clans ───────────────────────────────────────────────────────
  // Même logique que le pont Daily Algo : un interrupteur à part, pour qu'un
  // serveur puisse couper l'apport du RPG au classement des clans sans avoir à
  // remettre à zéro les points de chaque monstre du bestiaire.
  clanPointsFromRpg Boolean @default(false)

  // ── Drops aléatoires (page Drops) ──────────────────────────────────────────
  /// Interrupteur maître de la page. Chaque type de drop garde le sien : couper
  /// ici arrête tout sans avoir à éteindre les quatre ressources une par une.
  dropsEnabled Boolean @default(false)
  /// Salon de repli, utilisé par les types de drop qui n'en désignent pas.
  dropChannelId String?
  /// Rôle mentionné à l'apparition d'un drop. Vide = aucune mention.
  dropMentionRoleId String?
  /// Durée de vie d'un drop que personne ne ramasse, en minutes. Le mode
  /// fenêtre a la sienne : elle est annoncée aux membres, celle-ci non.
  /// Plancher de cinq minutes appliqué à la lecture (voir `@kotbo/shared`).
  dropLifetimeMinutes Int @default(60)

  clans                 Clan[]
  dropConfigs           DropConfig[]
  drops                 Drop[]
  clanMemberContributions ClanMemberContribution[]
  clanContributionEvents ClanContributionEvent[]
  clanBets ClanBet[]
  clanBetSeasonAwards ClanBetSeasonAward[]
  clanWeeklyDigests   ClanWeeklyDigest[]
  clanPointDebts ClanPointDebt[]
  clanDebtSnapshots ClanDebtSnapshot[]
  memberLevels MemberLevel[]
  levelRoleRewards LevelRoleReward[]
  levelConfig LevelConfig?
  giveaways Giveaway[]
  giveawayConfig GiveawayConfig?
  welcomeConfig WelcomeConfig?
  welcomeThreadConfig WelcomeThreadConfig?
  reactionRoleMenus ReactionRoleMenu[]
  autoResponses AutoResponse[]
  autoModConfig AutoModConfig?
  suggestions Suggestion[]

  newsArticles NewsArticle[]
  newsCategoryConfigs NewsCategoryConfig[]
  dailyAlgoRuns DailyAlgoRun[]
  dailyAlgoWeeks DailyAlgoWeek[]
  dailyAlgoBonusPoints DailyAlgoBonusPoint[]
  dashboardSettings DashboardSettings?
  dashboardAuditLogs DashboardAuditLog[]
  sanctions Sanction[]
  sanctionTables SanctionTable[]
  sanctionReports SanctionReport[]
  sanctionEvidenceFiles SanctionEvidenceFile[]
  regulationArticles GuildRegulationArticle[]
  memberProfiles MemberProfile[]
  staffMembers StaffMember[] @relation("GuildStaffMembers")
  staffRoles StaffRole[] @relation("GuildStaffRoles")
  staffHierarchies StaffHierarchy[] @relation("GuildStaffHierarchies")
  chiefStaffRoleId String?   // Rôle Discord du Resp Staff global
  chiefStaffUserId String?   // UserId Discord du Resp Staff actuel
  staffAbsences StaffAbsence[]
  staffMeetings StaffMeeting[]
  staffManagerNotes StaffManagerNote[]
  staffPolls StaffPoll[]
  staffResignations StaffResignation[]
  staffProcedures StaffProcedure[]
  candidatures RecruitmentCandidature[]
  recruitmentForms RecruitmentForm[]
  notifications Notification[]
  guildDailyStats GuildDailyStat[]
  guildHourlyStats GuildHourlyStat[]
  channelDailyStats ChannelDailyStat[]
  memberDailyStats MemberDailyStat[]
  memberInvites MemberInvite[]
  guildInvites  GuildInvite[]
  suspendedInviters SuspendedInviter[]
  linkedAccounts LinkedAccount[]
  youtubeFollows YoutubeChannelFollow[]
  twitchFollows TwitchChannelFollow[]
  feeds Feed[]

  tutoringConfig TutoringConfig?
  tutoringItems TutoringItem[]
  dashboardFeatureConfigs DashboardFeatureConfig[]
  layoutPresets DashboardLayoutPreset[]
  logEventConfigs GuildLogEventConfig[]
  events Event[]
  customForms CustomForm[]
  customFormSubmissions CustomFormSubmission[]
  banAppealConfig BanAppealConfig?
  banAppeals BanAppeal[]
  banAppealSanctions BanAppealSanction[]
  banAppealBlacklist BanAppealBlacklist[]
  adminPermissionRequests AdminPermissionRequest[]
  moduleActivationStats ModuleActivationStat[]
  moduleUsageStats ModuleUsageStat[]
  modulePerformanceStats ModulePerformanceStat[]

  ticketCategoryId       String?
  ticketLogChannelId     String?
  ticketStaffRoleId      String?
  ticketChannelId        String?
  ticketEmbedTitle       String   @default("Support Technique")
  ticketEmbedDesc        String   @default("Cliquez sur le bouton ci-dessous pour ouvrir un ticket d'assistance.")
  ticketEmbedButtonText  String   @default("Ouvrir un ticket")
  ticketEmbedColor       String   @default("#5865F2")
  ticketEmbedType        String   @default("BUTTONS") // "BUTTONS" or "DROPDOWN"
  ticketMode             String   @default("CHANNEL") // "CHANNEL", "DM", "THREAD"
  ticketDmRelayChannelId String?
  ticketTypes             Json?
  ticketFormEnabled           Boolean  @default(true)
  ticketFormCustomFields      Json?
  ticketEmbedThumbnail        String?
  ticketEmbedImage            String?
  ticketEmbedFooter           String?
  ticketEmbedAuthorName       String?
  ticketEmbedAuthorIcon       String?
  ticketWelcomeTitle          String   @default("🎫 Ticket d'Assistance · {type_label}")
  ticketWelcomeDesc           String   @default("Bonjour {user} !\nLe personnel {staff_mention} va prendre en charge votre demande rapidement. En attendant, merci de bien détailler vos questions ou explications.\n\n**Description du problème :**\n{description}")
  ticketWelcomeColor          String   @default("#5865F2")
  ticketWelcomeThumbnail      String?
  ticketWelcomeImage          String?
  ticketWelcomeFooter         String   @default("Kotbo · Ticket ID: {ticket_id}")
  ticketAllowOverclaim        Boolean  @default(true)
  ticketOverclaimPermission   String   @default("ANY") // "ANY", "SUPERIOR_OR_EQUAL", "NONE"
  // Le premier message d'un staff dans un ticket OPEN vaut prise en charge :
  // evite l'oubli du bouton « Prendre en charge » avant d'intervenir.
  ticketAutoClaimOnReply      Boolean  @default(false)
  ticketInactivityEnabled     Boolean  @default(false)
  ticketInactivityHours       Int      @default(24)
  ticketInactivityMessage     String   @default("Bonjour {user}, votre ticket est inactif depuis un moment. N'hésitez pas à y répondre si vous avez toujours besoin d'aide !")
  // Question facultative posée après la note du sondage de satisfaction.
  ticketSatisfactionCommentEnabled  Boolean @default(true)
  ticketSatisfactionCommentQuestion String  @default("")
  // Délai (secondes) avant que le bouton « Ajouter un commentaire » n'expire.
  ticketSatisfactionCommentTimeout  Int     @default(120)
  // Salon où republier chaque avis sous forme d'embed. `null` = pas de relais.
  ticketSatisfactionLogChannelId    String?
  ticketSatisfactionLogAnonymous    Boolean @default(false)
  // Salon ouvert mais verrouillé tant qu'aucun staff ne l'a pris en charge :
  // l'auteur et le staff le voient, personne n'y écrit avant le claim.
  ticketLockUntilClaim        Boolean  @default(false)
  // Validation préalable : la demande attend l'accord d'un staff avant que le
  // salon (ou le fil) ne soit créé.
  ticketApprovalEnabled       Boolean  @default(false)
  // Salon où atterrissent les demandes à valider. Vide = salon de logs tickets.
  ticketApprovalChannelId     String?
  // ── Quotas tickets ────────────────────────────────────────────────────────
  // Chaque quota s'active independamment ; desactive, il n'impose aucune
  // limite. Un type de ticket peut surcharger les valeurs via `ticketTypes`
  // (voir `resolveTicketQuotas`) : `null` sur le type = herite du serveur.

  // Tickets ouverts simultanement par un meme membre (PENDING + OPEN + CLAIMED).
  ticketQuotaOpenEnabled      Boolean  @default(false)
  ticketQuotaOpenMax          Int      @default(1)
  // Delai minimum entre deux ouvertures, en minutes.
  ticketQuotaCooldownEnabled  Boolean  @default(false)
  ticketQuotaCooldownMinutes  Int      @default(30)
  // Nombre d'ouvertures tolerees sur une fenetre glissante.
  ticketQuotaPeriodEnabled    Boolean  @default(false)
  ticketQuotaPeriodMax        Int      @default(5)
  ticketQuotaPeriodHours      Int      @default(24)
  // Charge d'un membre du staff : tickets pris en charge et encore ouverts.
  // OFF = pas de plafond, WARN = previent sans empecher, BLOCK = refuse.
  ticketQuotaStaffLoadMode    String   @default("OFF")
  ticketQuotaStaffLoadMax     Int      @default(5)
  // Roles qui passent outre le plafond de charge, meme en mode BLOCK : sans
  // eux, un serveur ou tout le staff est plein ne peut plus prendre un ticket.
  ticketQuotaStaffLoadBypassRoleIds String[] @default([])
  // Reouvertures d'un meme ticket. Remplace la constante MAX_TICKET_RESTORES.
  ticketQuotaReopenEnabled    Boolean  @default(false)
  ticketQuotaReopenMax        Int      @default(3)

  // Catégorie où sont rangés les salons des tickets archivés. Vide = le salon
  // reste où il est, seules ses permissions passent en lecture seule.
  ticketArchiveCategoryId     String?
  // L'auteur garde-t-il l'accès en lecture à son ticket une fois archivé ?
  ticketArchiveKeepOpenerView Boolean  @default(false)
  // Panneau « Mes anciens tickets » sous l'embed d'ouverture : le membre y
  // retrouve ses tickets clos, leur transcription, et peut demander une
  // réouverture ou la suppression définitive.
  ticketHistoryPanelEnabled   Boolean  @default(true)
  // Le membre peut-il demander lui-même la réouverture d'un de ses tickets ?
  ticketSelfReopenEnabled     Boolean  @default(true)
  // Le membre peut-il supprimer définitivement l'un de ses anciens tickets ?
  ticketSelfDeleteEnabled     Boolean  @default(false)
  tickets                Ticket[]
  ticketBlacklist        TicketBlacklist[]
  ticketMacros           TicketMacro[]
  campaigns              Campaign[]

  autoThreadEnabled  Boolean   @default(false)
  autoThreadChannels String[]  @default([])
  autoThreadBotsEnabled Boolean @default(false)

  // Statistics Channels
  statsEnabled            Boolean  @default(false)
  statsConfig             Json?

  // ── Collecte analytique (opt-out serveur) ─────────────────────────────────
  // Interrupteur unique du module « analytics ». À false, plus aucune activité
  // de membre n'est enregistrée : messages, vocal, réactions, threads, mots et
  // compteurs d'usage par module s'arrêtent à la source (voir
  // services/analytics/analyticsConsent.ts). Le reste du bot continue de
  // fonctionner : c'est la collecte qui est coupée, pas les fonctionnalités.
  analyticsEnabled        Boolean  @default(true)

  // Message logging / global message search
  messageLoggingEnabled       Boolean  @default(false)
  messageLoggingRetentionDays Int      @default(90)
  messageLoggingIgnoredChannels String[] @default([])
  messageLoggingStatus        Json?
  messageLogs             MessageLog[]

  // Mise en place guidée du serveur : une seule fois par serveur, l'horodatage
  // faisant foi. Un administrateur du bot peut le remettre à null pour rouvrir
  // la création.
  serverTemplateAppliedAt DateTime?
  serverTemplateAppliedBy String?
  serverTemplateSections  String[] @default([])
  // Identifiants créés, par clé du plan. Tous les salons du plan n'ont pas de
  // champ de configuration où se ranger : sans cette trace, une reprise après
  // échec les créerait une seconde fois.
  serverTemplateRefs      Json?

  // Temporary Voice Channels
  tempVoiceEnabled        Boolean  @default(false)
  tempVoiceChannelId      String?
  tempVoiceCategoryId     String?
  tempVoiceNameTemplate   String   @default("🔊 Salon de {user}")
  tempVoiceRequiredRoleId String?
  tempVoiceGenerators     Json?
  tempVoiceChannels       TempVoiceChannel[]

  // Honeypot trap channels
  honeypotEnabled         Boolean  @default(false)
  honeypotChannelId       String?
  honeypotSanction        SanctionType @default(TIMEOUT)
  honeypotReinvite        Boolean  @default(false)

  // Backup system
  backups ServerBackup[]
  scheduledTasks ScheduledTask[]

  // Fun Channels configuration
  funEnabled               Boolean  @default(false)
  funCountingChannelId     String?
  funOneWordStoryChannelId String?
  funGuessNumberChannelId  String?
  funWordChainChannelId    String?
  funEmojiRiddleChannelId  String?
  funNeverSayChannelId     String?
  funEmojiOnlyChannelId    String?
  // Comptage et chaîne de mots : une erreur remet le jeu à zéro quand actif ;
  // sinon le message fautif est juste supprimé, sans casser la progression.
  funPunitiveMode          Boolean  @default(true)
  funGameState             FunGameState?

  // Economy & RPG Module
  economyEnabled           Boolean  @default(false)
  economyChannelId         String?
  economyConfig            EconomyConfig?
  rpgProfiles              RpgProfile[]
  rpgGuilds                RpgGuild[]
  rpgItems                 RpgItem[]
  rpgRecipes               RpgRecipe[]
  rpgAdventureEvents       RpgAdventureEvent[]
  rpgDrops                 RpgDrop[]
  rpgMonsters              RpgMonster[]
  rpgBattles               RpgBattle[]
  rpgFishCatches           RpgFishCatch[]
  rpgBlackMarketSessions   RpgBlackMarketSession[]
  rpgRaidBosses            RpgRaidBoss[]
  rpgRaids                 RpgRaid[]
  rpgQuests                RpgQuest[]
  rpgQuestProgress         RpgQuestProgress[]
  rpgQuestTeamProgress     RpgQuestTeamProgress[]

  staffTasks StaffTask[]
  staffCalls StaffCall[]
  callPermissionConfig CallPermissionConfig?

  mcpApiKeys McpApiKey[]
  customBotConfig CustomBotConfig?

  // Cross-server channel linking
  channelLinksAsSource ChannelLink[] @relation("GuildChannelLinksSource")
  channelLinksAsTarget ChannelLink[] @relation("GuildChannelLinksTarget")
  channelLinkInvites   ChannelLinkInvite[] @relation("GuildChannelLinkInvites")
  channelLinkGroups       ChannelLinkGroup[]       @relation("GuildChannelLinkGroups")
  channelLinkMemberships  ChannelLinkGroupMember[] @relation("GuildChannelLinkMemberships")

  // Staff server linking
  staffServerLinksAsMain  StaffServerLink[] @relation("GuildStaffServerMain")
  staffServerLinksAsStaff StaffServerLink[] @relation("GuildStaffServerStaff")

  // Security Verification (anti-DC via dashboard OAuth)
  verificationEnabled       Boolean            @default(false)
  verificationMode          VerificationMode   @default(EMBED)
  verificationAction        VerificationAction @default(NOTIFY_STAFF)
  verificationChannelId     String?
  verificationRoleId        String?
  verificationLogChannelId  String?
  // Salon parent des threads privés créés quand le MP de vérification échoue.
  // Repli sur verificationChannelId, puis sur un ticket si aucun des deux n'est configuré.
  verificationFallbackChannelId String?
  verificationEmbedTitle    String   @default("Vérification de sécurité")
  verificationEmbedDesc     String   @default("Cliquez sur le bouton ci-dessous pour vérifier votre identité et sécuriser votre compte.")
  verificationEmbedColor    String   @default("#5865F2")
  verificationOnJoin        Boolean  @default(true)
  verificationSaveIp        Boolean  @default(true)
  verificationSaveDevice    Boolean  @default(true)
  verificationLevelCommand  VerificationLevel  @default(HIGH)
  verificationLevelJoin     VerificationLevel  @default(HIGH)
  verificationWarnThreshold Int?               // null = désactivé. Nombre de warns déclenchant la vérif auto
  verificationWarnAutoMode  String             @default("FULL_AUTO") // FULL_AUTO | NOTIFY_STAFF
  verificationWarnReason    String             @default("Seuil d'avertissements atteint - vérification de sécurité requise.")

  // Warns pondérés : chaque warn porte un poids (1/2/3) et perd sa valeur avec le temps.
  // Quand actif, les seuils (vérif auto, escalade) utilisent le score pondéré au lieu du compte brut.
  warnWeightingEnabled Boolean @default(false)
  warnDecayDays        Int?    // null = pas de décroissance. Un warn ne compte plus après N jours.

  // Une sanction archivée est « désactivée mais conservée ». Par défaut elle
  // sort du score de warns et de l'escalade automatique ; ce commutateur permet
  // aux serveurs qui veulent un archivage purement visuel de la garder au bilan.
  countArchivedInWarnScore Boolean @default(false)

  // Archivage automatique des warns au-delà de N jours (null = désactivé).
  // Le warn quitte le casier actif sans être effacé, comme un archivage manuel.
  warnAutoArchiveDays Int?

  // Statistiques de mots fréquents (agrégats anonymes par jour, sans contenu brut)
  wordStatsEnabled Boolean @default(false)
  // Suivi de l'indexation initiale depuis les messages déjà journalisés
  wordStatsBackfillStatus Json?

  // Hygiène des bans : détection des comptes bannis supprimés par Discord
  banHygieneEnabled Boolean @default(true)
  securityVerifications SecurityVerification[]
  autoLeaderboards AutoLeaderboard[]
  wordStats GuildWordStat[]
  banHygieneRecords BanHygieneRecord[]

  // Détection de double compte - intelligence avancée
  dcVoiceSessions    DcVoiceSession[]
  dcDetectionSamples DcDetectionSample[]
  dcSignalWeights    DcSignalWeight[]

  // Moteur anti-spam comportemental
  spamDetectionConfig  SpamDetectionConfig?
  spamDetectionSamples SpamDetectionSample[]
  spamSignalWeights    SpamSignalWeight[]

  // Sticky bot - message collé en bas de salon
  stickyMessages StickyMessage[]

  // Starlight - mise en avant des messages plébiscités
  starboardConfig StarboardConfig?

  // Channel Health Monitor
  channelHealthConfig ChannelHealthConfig?
  channelHealthAlerts ChannelHealthAlert[]

  // Pulse - Server Health Score
  pulseSnapshots PulseSnapshot[]

  // Reputation System
  reputationVotes ReputationVote[]

  // Ticket Satisfaction
  ticketSatisfactions TicketSatisfaction[]

  // Leveling Seasons
  levelingSeasons LevelingSeason[]
  seasonSnapshots SeasonSnapshot[]

  // Ranked (RP compétitif greffé sur le leveling)
  rankedConfig       RankedConfig?
  rankedMembers      RankedMember[]
  rankedTierRoles    RankedTierRole[]
  rankedRpLogs       RankedRpLog[]
  rankedEvents       RankedEvent[]
  rankedSeasonEntries RankedSeasonEntry[]

  // Staff Performance Evaluations
  staffEvaluations StaffEvaluation[]

  // Marketplace
  marketplaceListings MarketplaceListing[]
  marketplaceTransactions MarketplaceTransaction[]

  // Quests
  questDefinitions QuestDefinition[]
  questProgress QuestProgress[]
  dashboardUserSettings DashboardUserSettings[]

  // Widget (Social Layer SDK)
  widgetSubscriptions WidgetSubscription[]
  reminders           StaffReminder[]

  // Protection anti-raid (captcha, raid mode, locks, reports, scam filter)
  raidProtectionConfig RaidProtectionConfig?
  captchaSessions      CaptchaSession[]
  memberReports        MemberReport[]
  scamImageHashes      ScamImageHash[]
  inviteApprovalRequests InviteApprovalRequest[]

  // Ghost Members Analyzer (audit de présence silencieuse)
  ghostAnalyzerConfig GhostAnalyzerConfig?
  ghostPruneRuns      GhostPruneRun[]

  // Interactive Audit Logger (états avant/après + diff visuel)
  auditLoggerConfig AuditLoggerConfig?
  auditEvents       AuditEvent[]

  // Node Workflow Builder (automatisations par blocs)
  workflows          Workflow[]
  workflowExecutions WorkflowExecution[]

  // Staff Simulator (entraînement des modérateurs)
  simulationConfig    SimulationConfig?
  simulationScenarios SimulationScenario[]
  simulationSessions  SimulationSession[]

  @@map("guilds")
}

model GuildRegulationArticle {
  id String @id @default(cuid())

  guildId String
  title String
  description String
  emoji String?
  sortOrder Int @default(0)
  enabled Boolean @default(true)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("guild_regulation_articles")
  @@index([guildId, enabled, sortOrder])
}



model MemberProfile {
  id String @id @default(cuid())

  guildId String
  userId String

  userTag String?
  username String?
  globalName String?
  displayName String?
  avatarUrl String?
  bannerUrl String?
  accentColor Int?
  locale String?
  isBot Boolean @default(false)
  bio String?
  isProfilePrivate Boolean @default(true)

  accountCreatedAt DateTime?
  guildJoinedAt DateTime?
  guildLeftAt DateTime?
  firstSeenAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  // Fin de l'écran d'accueil Discord (membership screening) : pending → validé
  onboardingCompletedAt DateTime?

  lastMessageAt DateTime?
  lastMessageChannelId String?
  messageCount Int @default(0)

  voiceSessionCount Int @default(0)
  voiceTimeSeconds Int @default(0)
  voiceLastChannelId String?
  voiceLastJoinedAt DateTime?
  voiceLastLeftAt DateTime?

  // Ghost Members Analyzer - signaux d'activité silencieuse (lecture, écoute,
  // réactions) qui distinguent un spectateur fidèle d'un compte abandonné.
  lastReactionAt DateTime?
  lastDashboardLoginAt DateTime?
  // Interactions non textuelles cumulées : réactions, boutons, menus, commandes
  interactionCount Int @default(0)
  // Classification calculée : ACTIVE | SPECTATOR | INACTIVE | NEW
  ghostStatus String?
  ghostComputedAt DateTime?

  rolesSnapshot String[] @default([])

  isSuspectedDC Boolean @default(false)
  dcScore       Int?      // Dernier score de détection calculé (0-100)
  lastDcAlertAt DateTime? // Timestamp de la dernière alerte DC envoyée (cooldown 24h)

  moderatorNote String?

  // Confidentialité : le membre a coupé l'exploitation de sa présence Discord
  // (statut personnalisé, activité en cours, statut en ligne) via
  // `/opt-out presence` ou les réglages de confidentialité du dashboard.
  // Le choix est propre au serveur, comme le reste du profil.
  presenceTrackingOptOut Boolean @default(false)
  presenceOptOutAt DateTime?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  eventParticipations EventParticipant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, userId])
  @@index([guildId, lastSeenAt])
  @@index([guildId, guildJoinedAt])
  @@index([guildId, messageCount])
  @@index([guildId, username])
  @@index([guildId, ghostStatus])
  @@map("member_profiles")
}


model WelcomeConfig {
  guildId        String  @id
  welcomeEnabled Boolean @default(false)
  welcomeChannelId String?
  welcomeMessage String  @default("Bienvenue {user} sur notre serveur ! 🎉")
  welcomeImageEnabled Boolean @default(false)
  welcomeImageUrl String?

  leaveEnabled   Boolean @default(false)
  leaveChannelId String?
  leaveMessage   String  @default("Au revoir {user}... 😢")

  // Custom Boost Announcement
  boostEnabled      Boolean @default(false)
  boostChannelId    String?
  boostMessage      String  @default("Merci pour ton boost {user} ! 🚀")
  boostImageEnabled Boolean @default(false)
  boostImageUrl     String?

  // Auto Role
  joinRoleId String?

  // ── Auto-rôle « tag du serveur » ───────────────────────────────────────────
  // Basé sur l'API officielle (user.primary_guild) : le tag identitaire que le
  // membre affiche à côté de son pseudo, pas un motif cherché dans le pseudo.
  tagAutoRoleEnabled Boolean @default(false)
  tagAutoRoleId      String?

  // ── Auto-rôle « mot-clé dans la présence » ─────────────────────────────────
  // Scanne le statut personnalisé et/ou le texte de l'activité en cours à la
  // recherche d'un mot-clé (ex. « .gg/kotbo »). Le rôle attribué peut être le
  // même que celui du tag (statusScanRoleId nul) ou un rôle distinct.
  statusScanEnabled Boolean @default(false)
  statusScanKeyword String  @default("")
  statusScanRoleId  String?
  /// STATUS = statut personnalisé | ACTIVITY = texte de l'activité | BOTH = les deux
  statusScanScope   String  @default("STATUS")

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@map("welcome_configs")
}

// ── Accueil personnalisé : thread de bienvenue scénarisé ──────────
model WelcomeThreadConfig {
  guildId   String  @id
  enabled   Boolean @default(false)
  channelId String? // Salon bienvenue où les threads sont créés

  threadNameTemplate String  @default("👋 Bienvenue {username} !")
  threadMode         String  @default("public") // "public" | "private"
  autoArchiveMinutes Int     @default(1440) // 60 | 1440 | 4320 | 10080
  typingEnabled      Boolean @default(true) // Indicateur "est en train d'écrire" avant chaque message

  // Purge des threads d'accueil laissés sans activité : sans ça ils s'accumulent
  // indéfiniment dans le salon (l'archivage Discord ne supprime rien).
  inactivityDeleteEnabled Boolean @default(true)
  inactivityDeleteHours   Int     @default(48)

  // Persona webhook par défaut (surchargeable message par message)
  webhookName      String  @default("Kotbo")
  webhookAvatarUrl String?

  // Embed d'accueil final avec menu de présentation du serveur
  menuEnabled       Boolean @default(true)
  menuStyle         String  @default("buttons") // "buttons" | "select"
  menuPlaceholder   String  @default("Découvrir le serveur...")
  embedTitle        String  @default("Bienvenue sur {server} !")
  embedDescription  String  @default("Explore les sections ci-dessous pour découvrir le serveur. 👇")
  embedColor        String  @default("#5865F2")
  embedImageUrl     String?
  embedThumbnailUrl String?

  steps WelcomeThreadStep[]
  pages WelcomeMenuPage[]

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@map("welcome_thread_configs")
}

// Message scénarisé envoyé via webhook dans le thread de bienvenue
model WelcomeThreadStep {
  id      String @id @default(cuid())
  guildId String
  order   Int    @default(0)

  content   String
  name      String? // Nom du webhook pour ce message (null = persona par défaut)
  avatarUrl String? // Avatar du webhook pour ce message (null = persona par défaut)
  delayMs   Int     @default(3000) // Intervalle avant l'envoi (pendant lequel le typing est visible)

  config WelcomeThreadConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId, order])
  @@map("welcome_thread_steps")
}

// Page de présentation ouverte par le menu (bouton ou menu déroulant)
model WelcomeMenuPage {
  id      String  @id @default(cuid())
  guildId String
  order   Int     @default(0)
  label   String
  emoji   String?
  summary String? // Sous-texte affiché dans le menu déroulant

  // Action déclenchée au clic : "EMBED" (défaut, affiche une page) | "ROLE" | "LINK"
  actionType String  @default("EMBED")
  roleId     String? // Pour actionType = "ROLE"
  roleAction String  @default("ADD") // "ADD" | "REMOVE" | "TOGGLE" | "EXCLUSIVE"
  roleGroup  String? // Groupe mutuellement exclusif pour roleAction = "EXCLUSIVE"
  linkUrl    String? // Pour actionType = "LINK" (salon du serveur ou URL externe)

  // Utilisés uniquement pour actionType = "EMBED"
  embedTitle        String?
  embedDescription  String?
  embedColor        String  @default("#5865F2")
  embedImageUrl     String?
  embedThumbnailUrl String?

  config WelcomeThreadConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId, order])
  @@map("welcome_menu_pages")
}

model GuildLogEventConfig {
  id        String   @id @default(cuid())
  guildId   String
  eventType String   // ex: "message_delete", "voice_activity", etc.
  enabled   Boolean  @default(true)
  channelId String?  // Salon Discord spécifique (null = salon par défaut)

  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, eventType])
  @@map("guild_log_event_configs")
}

model TempVoiceChannel {
  id         String   @id
  guildId    String
  creatorId  String
  roleId     String?  // Optional role restriction
  createdAt  DateTime @default(now())

  guild      Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@map("temp_voice_channels")
}
