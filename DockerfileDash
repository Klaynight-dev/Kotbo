# Build stage
FROM oven/bun:1-alpine AS builder

WORKDIR /app
ENV PRISMA_HIDE_UPDATE_MESSAGE=true

# Copy root monorepo config
COPY package.json bun.lock tsconfig.json bunfig.toml ./

# Copy all workspace package.json for resolution
COPY apps/dashboard/package.json apps/dashboard/
COPY apps/bot/package.json apps/bot/
COPY packages/database/package.json packages/database/
COPY packages/core/package.json packages/core/
COPY packages/contracts/package.json packages/contracts/
COPY packages/shared/package.json packages/shared/

# Install dependencies (only for the dashboard)
RUN bun install --frozen-lockfile

# Copy dashboard source and workspace packages
COPY packages packages
COPY apps/dashboard apps/dashboard

# Build the Svelte app
WORKDIR /app/apps/dashboard
ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}
RUN bun run build

# Pre-compression gzip des assets textuels, servis ensuite par `gzip_static on`
# (cf. apps/dashboard/nginx.conf). On compresse au niveau 9 une fois pour toutes
# au lieu de recompresser a chaque requete. `-k` conserve l'original, necessaire
# pour les clients qui n'annoncent pas gzip.
# woff2/woff/png/jpg sont deja compresses : on les laisse tels quels.
RUN find dist -type f \
      \( -name '*.js' -o -name '*.css' -o -name '*.html' -o -name '*.json' \
         -o -name '*.svg' -o -name '*.webmanifest' \) \
      -size +1k -exec gzip -9 -k {} \;

# Production stage
FROM nginx:alpine

# Copy built files from builder
COPY --from=builder /app/apps/dashboard/dist /usr/share/nginx/html

# Copy custom Nginx config for SPA routing
COPY apps/dashboard/nginx.conf /etc/nginx/conf.d/default.conf

# Aiguillage des robots d'apercu vers /api/og/preview de l'API (cf. nginx.conf).
# On reutilise VITE_API_URL - la SPA et le proxy pointent ainsi forcement sur la
# meme API - en retirant l'eventuel slash final, qui donnerait une URL en `//api`.
# Sans VITE_API_URL, le placeholder reste en place et l'aiguillage se desactive.
ARG VITE_API_URL
RUN if [ -n "${VITE_API_URL}" ]; then \
      sed -i "s|__OG_API_ORIGIN__|$(echo "${VITE_API_URL}" | sed 's:/*$::')|g" /etc/nginx/conf.d/default.conf; \
    fi \
 && nginx -t

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
