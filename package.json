{
  "name": "kotbo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:bot": "bun run --filter @kotbo/bot dev",
    "dev:dashboard": "bun run --filter @kotbo/dashboard dev",
    "dev:bot:safe": "bun run --filter @kotbo/bot dev:safe",
    "dev": "bun run --filter @kotbo/bot dev",
    "build:dashboard": "bun run --filter @kotbo/dashboard build",
    "build:bot": "bun run --filter @kotbo/bot build",
    "build": "bun run build:dashboard && bun run build:bot",
    "test:bot": "bun run --filter @kotbo/bot test:unit",
    "coverage:bot": "bun run --filter @kotbo/bot coverage:gate",
    "test": "bun run test:bot",
    "quality:bot": "bun run --filter @kotbo/bot quality:gate",
    "db:generate": "bun run --filter @kotbo/database generate",
    "db:generate:force": "powershell -ExecutionPolicy RemoteSigned -File ./scripts/fix-prisma.ps1",
    "db:setup": "bun run db:generate && bun run db:migrate:deploy",
    "db:migrate": "bun run --filter @kotbo/database migrate",
    "db:migrate:deploy": "bun run --filter @kotbo/database migrate:deploy",
    "db:migrate:repair-production": "bun run --filter @kotbo/database migrate:repair-production",
    "db:push": "bun run --filter @kotbo/database push",
    "db:seed": "bun run --filter @kotbo/database seed",
    "stripe:bootstrap": "bun run scripts/stripe-bootstrap.ts",
    "stripe:bootstrap:dry": "bun run scripts/stripe-bootstrap.ts --dry-run",
    "analytics:backfill": "bun run scripts/backfill-acquisition.ts",
    "analytics:backfill:dry": "bun run scripts/backfill-acquisition.ts --dry-run",
    "db:backup": "powershell -ExecutionPolicy Bypass -File ./scripts/backup-database.ps1",
    "dev:all": "bun run --filter '*' dev",
    "setup": "bun run db:generate && bun run db:push && bun run db:seed",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "services:logs": "docker compose logs -f",
    "deploy-commands": "bun run --filter @kotbo/bot deploy-commands",
    "deploy": "bun db:migrate:deploy && bun run quality:bot && bun deploy-commands",
    "update:all": "ncu -u && bun install && bun run quality:bot && bun deploy-commands",
    "update:dashboard": "ncu -u -f '^(?!@kotbo/.*)' && bun install && bun run quality:bot && bun deploy-commands",
    "update:bot": "ncu -u -f '^(?!@kotbo/.*)' && bun install && bun run quality:bot && bun deploy-commands",
    "lint:bot": "bun run --filter @kotbo/bot lint",
    "lint:dashboard": "bun run --filter @kotbo/dashboard lint",
    "lint": "bun run lint:bot && bun run lint:dashboard"
  },
  "dependencies": {
    "@prisma/client-runtime-utils": "^7.10.0",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "bun-types": "^1.4.1"
  }
}
